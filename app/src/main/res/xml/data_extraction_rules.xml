<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (API 31+).
    See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude media cache and download dirs -->
        <exclude
            domain="file"
            path="./exoplayer" />
        <exclude
            domain="file"
            path="./download" />
        <exclude
            domain="database"
            path="exoplayer_internal.db" />
        <!--
            Security: Exclude sensitive credential storage from cloud backup.
            Contains YT cookie, Rediplays token, AI API keys, Last.fm session, etc.
        -->
        <exclude
            domain="file"
            path="../datastore/" />
        <exclude
            domain="sharedpref"
            path="discord_token.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude media cache and download dirs -->
        <exclude
            domain="file"
            path="./exoplayer" />
        <exclude
            domain="file"
            path="./download" />
        <exclude
            domain="database"
            path="exoplayer_internal.db" />
        <!--
            Security: Exclude sensitive credential storage from device-to-device transfer.
            User should re-authenticate on a new device.
        -->
        <exclude
            domain="file"
            path="../datastore/" />
        <exclude
            domain="sharedpref"
            path="discord_token.xml" />
    </device-transfer>
</data-extraction-rules>